# -----------------------------------------------------------------------------
# Agentic Assurance Accelerator configuration. Copy this file to ".env" and edit as needed:
#     Windows:  copy .env.example .env
#     macOS/Linux:  cp .env.example .env
# The CLI and the web UI load .env automatically on startup.
# .env is git-ignored, so your tokens never get committed.
# -----------------------------------------------------------------------------

# --- Ollama (local LLM server) ---
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Models (use small models on CPU for speed) ---
# llama3.2:1b is much faster than 3b/llama3.1 on a CPU-only machine.
AGENTPROBE_GEN_MODEL=llama3.2:1b
AGENTPROBE_JUDGE_MODEL=llama3.2:1b
AGENTPROBE_EMBED_MODEL=nomic-embed-text

# --- Timeouts / paths ---
# Seconds to wait on each Ollama call (local judging can be slow on CPU).
AGENTPROBE_TIMEOUT=600
# Where golden sets, results, and reports are written.
AGENTPROBE_DATA_DIR=data

# --- Target agent credentials (only set the ones you use) ---
# Oracle Fusion AI Agent Studio (bearer token or session relay handled in the UI):
# ORACLE_FUSION_BEARER_TOKEN=

# ServiceNow Virtual Agent:
# SERVICENOW_USER=
# SERVICENOW_PASSWORD=

# OpenAI-compatible endpoint:
# OPENAI_COMPAT_TOKEN=
